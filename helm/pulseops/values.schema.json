{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["frontend", "backend", "secrets", "ingress", "monitoring"],
  "properties": {
    "frontend": {
      "type": "object",
      "required": ["image", "apiBaseUrl"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "apiBaseUrl": { "type": "string", "minLength": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string", "minLength": 1 },
        "jwtSecret": { "type": "string", "minLength": 1 }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "minLength": 1 },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["enabled", "prometheus", "grafana"],
      "properties": {
        "enabled": { "type": "boolean" },
        "prometheus": {
          "type": "object",
          "required": ["image", "scrapeInterval", "retention", "storageSize"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "scrapeInterval": { "type": "string", "minLength": 1 },
            "retention": { "type": "string", "minLength": 1 },
            "storageSize": { "type": "string", "minLength": 1 }
          }
        },
        "grafana": {
          "type": "object",
          "required": ["image", "storageSize"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "storageSize": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": { "type": "string", "minLength": 1 }
      }
    }
  }
}
