{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": [
    "frontend",
    "backend",
    "secrets",
    "ingress",
    "monitoring"
  ],
  "properties": {
    "frontend": {
      "type": "object",
      "required": [
        "image",
        "apiBaseUrl"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "apiBaseUrl": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "description": "The monitoring scheduler is process-local; more than one replica would run duplicate checks."
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "jwtSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "tuning": {
          "type": "object",
          "required": [
            "sharedBuffers",
            "maxConnections"
          ],
          "properties": {
            "sharedBuffers": {
              "type": "string",
              "pattern": "^[0-9]+(kB|MB|GB)$"
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 5
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "required": [
        "enabled",
        "prometheus",
        "grafana"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prometheus": {
          "type": "object",
          "required": [
            "image",
            "scrapeInterval",
            "retention",
            "storageSize",
            "evaluationInterval",
            "retentionSize",
            "service"
          ],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "scrapeInterval": {
              "type": "string",
              "minLength": 1
            },
            "retention": {
              "type": "string",
              "minLength": 1
            },
            "storageSize": {
              "type": "string",
              "minLength": 1
            },
            "evaluationInterval": {
              "type": "string",
              "minLength": 1
            },
            "retentionSize": {
              "type": "string",
              "pattern": "^[0-9]+(KB|MB|GB)$"
            },
            "kubernetesSD": {
              "type": "boolean"
            },
            "scrapeCadvisor": {
              "type": "boolean"
            },
            "service": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "ClusterIP",
                    "NodePort"
                  ]
                },
                "nodePort": {
                  "type": "integer",
                  "minimum": 30000,
                  "maximum": 32767
                }
              }
            }
          }
        },
        "grafana": {
          "type": "object",
          "required": [
            "image",
            "storageSize",
            "service"
          ],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "storageSize": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "ClusterIP",
                    "NodePort"
                  ]
                },
                "nodePort": {
                  "type": "integer",
                  "minimum": 30000,
                  "maximum": 32767
                }
              }
            }
          }
        },
        "nodeExporter": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
